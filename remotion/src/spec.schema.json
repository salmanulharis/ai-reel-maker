      "title": "SpecClip",
      "type": "object"
    },
    "SpecNarration": {
      "properties": {
        "beat": {
          "title": "Beat",
          "type": "string"
        },
        "duration": {
          "title": "Duration",
          "type": "number"
        },
        "src": {
          "title": "Src",
          "type": "string"
        },
        "start": {
          "title": "Start",
