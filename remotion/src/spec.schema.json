      "type": "number"
    },
    "fps": {
      "title": "Fps",
      "type": "number"
    },
    "height": {
      "title": "Height",
      "type": "integer"
    },
    "narration": {
      "items": {
        "$ref": "#/$defs/SpecNarration"
      },
      "title": "Narration",
      "type": "array"
    },
    "texts": {
      "items": {
        "$ref": "#/$defs/SpecText"
      },
      "title": "Texts",
      "type": "array"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "video": {
      "$ref": "#/$defs/SpecVideo"
    },
    "width": {
      "title": "Width",
      "type": "integer"
    }
