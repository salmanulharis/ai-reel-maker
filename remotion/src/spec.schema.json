      "properties": {
        "end": {
          "title": "End",
          "type": "number"
        },
        "source_start": {
          "title": "Source Start",
          "type": "number"
        },
        "src": {
          "title": "Src",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        }
      },
      "required": [
        "src",
        "start",
        "end",
        "source_start"
