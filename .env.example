# Runtime
APP_HOST=0.0.0.0
APP_PORT=5000
APP_PUBLISH_PORT=18527
FLASK_ENV=production
SECRET_KEY=change-me-local-only

# Ollama
# Docker: http://host.docker.internal:11434
# Native Windows/macOS/Linux: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_TIMEOUT=900
OLLAMA_MAX_RETRIES=2
OLLAMA_NUM_CTX=8192
OLLAMA_VISION_MAX_IMAGES=1
OLLAMA_VISION_MAX_PIXELS=512
OLLAMA_VISION_JPEG_QUALITY=75
OLLAMA_VISION_NUM_CTX=4096
OLLAMA_VISION_NUM_PREDICT=256
OLLAMA_VISION_BATCH_SIZE=4
OLLAMA_VISION_MIN_SCENE_DURATION=1.0
OLLAMA_TEXT_BATCH_SIZE=20
OLLAMA_TEXT_NUM_CTX=4096
OLLAMA_TEXT_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_THREAD=6
OLLAMA_WARM_ON_START=true

WHISPER_CPU_THREADS=6
WHISPER_NUM_WORKERS=1
WORKER_IDLE_SLEEP=1.5

# Storage (relative paths resolve from project root)
DATA_DIR=./data
TEMP_DIR=./data/tmp
MAX_UPLOAD_SIZE_GB=10

# Highlight defaults
TARGET_MIN_DURATION=20
TARGET_MAX_DURATION=30
DEFAULT_MIN_DURATION=20
DEFAULT_MAX_DURATION=30

# Analysis
ENABLE_WHISPER=true
WHISPER_MODEL=base
WHISPER_DEVICE=auto
AI_CONFIG_MODE=auto
ENABLE_SCENE_DETECTION=true
ENABLE_VISUAL_ANALYSIS=true
ENABLE_REPETITION_ANALYSIS=true

# Output
OUTPUT_FORMAT=mp4
OUTPUT_VIDEO_CODEC=auto
OUTPUT_CRF=18
OUTPUT_AUDIO_BITRATE=192k

# Cache
KEEP_CACHE=true
CACHE_RETENTION_DAYS=7
KEEP_ANALYSIS_CACHE_DAYS=7
DEBUG_ANALYSIS=false
