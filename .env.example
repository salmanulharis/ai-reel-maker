# Runtime
APP_HOST=0.0.0.0
APP_PORT=5000
APP_PUBLISH_PORT=18527
FLASK_ENV=production
SECRET_KEY=change-me-local-only

# Ollama (host.docker.internal reaches Ollama on the Docker host)
# Native (non-Docker) installs typically use http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300
OLLAMA_MAX_RETRIES=2

# Storage
DATA_DIR=/app/data
TEMP_DIR=/app/data/tmp
MAX_UPLOAD_SIZE_GB=10

# Highlight defaults
TARGET_MIN_DURATION=20
TARGET_MAX_DURATION=30
DEFAULT_MIN_DURATION=20
DEFAULT_MAX_DURATION=30

# Analysis
ENABLE_WHISPER=true
WHISPER_MODEL=small
ENABLE_SCENE_DETECTION=true
ENABLE_VISUAL_ANALYSIS=true
ENABLE_REPETITION_ANALYSIS=true

# Output
OUTPUT_FORMAT=mp4
OUTPUT_VIDEO_CODEC=auto
OUTPUT_CRF=18
OUTPUT_AUDIO_BITRATE=192k

# Cache
KEEP_CACHE=true
CACHE_RETENTION_DAYS=7
KEEP_ANALYSIS_CACHE_DAYS=7
DEBUG_ANALYSIS=false
